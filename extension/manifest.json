{
  "manifest_version": 3,
  "name": "Gmail Lisible",
  "short_name": "Gmail Lisible",
  "version": "1.5.3",
  "description": "Gmail plus lisible : conversations dépliées, contenu abrégé masqué, réponse flottante et séparateurs de dates.",
  "minimum_chrome_version": "111",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gmail Lisible",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "shared/defaults.js",
        "content/dates.js",
        "content/core.js",
        "content/expand.js",
        "content/history.js",
        "content/trimmed.js",
        "content/reply-popout.js",
        "content/attachments.js",
        "content/reverse.js",
        "content/day-separators.js",
        "content/settings-tab.js",
        "content/diagnostic.js"
      ],
      "run_at": "document_start"
    }
  ]
}
